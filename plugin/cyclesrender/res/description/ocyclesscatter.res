CONTAINER Ocyclesscatter
{
	NAME Ocyclesscatter;
	INCLUDE Obase;

	// Three tabs after the Octane Scatter's pages: the distribution (with where copies may go and the
	// shaders that vary them, position, rotation and scale each in a section of its own), the effectors and
	// fields (each in a section, open), the viewport. The layout of F11 step 3; ids never change with it.
	GROUP CYCLESSCATTER_GROUP_DISTRIBUTION
	{
		DEFAULT 1;

		LONG CYCLESSCATTER_MODE
		{
			ANIM OFF;
			CYCLE
			{
				CYCLESSCATTER_MODE_VERTICES;
				CYCLESSCATTER_MODE_SURFACE;
				CYCLESSCATTER_MODE_POISSON;
				CYCLESSCATTER_MODE_VOLUME;
				CYCLESSCATTER_MODE_FILE;
			}
		}
		LINK CYCLESSCATTER_SURFACE { ACCEPT { Obase; } }
		FILENAME CYCLESSCATTER_FILE { }
		BOOL CYCLESSCATTER_FILE_SEQUENCE { }
		LONG CYCLESSCATTER_FILE_FRAME_OFFSET { }
		LONG CYCLESSCATTER_COUNT { MIN 0; MAX 10000000; }
		REAL CYCLESSCATTER_POISSON_RADIUS { UNIT METER; MIN 0.001; STEP 1.0; }
		LONG CYCLESSCATTER_POISSON_SAMPLES { MIN 1; MAX 10000; }
		BOOL CYCLESSCATTER_POISSON_LIMIT { }
		LONG CYCLESSCATTER_SEED { MIN 0; }
		LONG CYCLESSCATTER_CHILD_ORDER
		{
			ANIM OFF;
			CYCLE
			{
				CYCLESSCATTER_CHILD_ORDER_RANDOM;
				CYCLESSCATTER_CHILD_ORDER_ITERATE;
			}
		}
		REAL CYCLESSCATTER_KEEP_AWAY { UNIT METER; MIN 0.0; STEP 1.0; }
		BOOL CYCLESSCATTER_REMOVE_COPIES { }
		SEPARATOR { LINE; }
		REAL CYCLESSCATTER_NORMAL_ALIGN { UNIT PERCENT; MIN 0.0; MAX 100.0; STEP 1.0; CUSTOMGUI REALSLIDER; }
		VECTOR CYCLESSCATTER_UP_VECTOR { STEP 0.1; }

		GROUP CYCLESSCATTER_GROUP_RESTRICT
		{
			DEFAULT 1;

			LINK CYCLESSCATTER_VERTEX_MAP { ACCEPT { 5682; } }
			REAL CYCLESSCATTER_VERTEX_MAP_LIMIT { UNIT PERCENT; MIN 0.0; MAX 100.0; STEP 1.0; CUSTOMGUI REALSLIDER; }
			SHADERLINK CYCLESSCATTER_DENSITY_SHADER { }
			REAL CYCLESSCATTER_DENSITY_MIN { UNIT PERCENT; MIN 0.0; MAX 100.0; STEP 1.0; CUSTOMGUI REALSLIDER; }
			REAL CYCLESSCATTER_DENSITY_MAX { UNIT PERCENT; MIN 0.0; MAX 100.0; STEP 1.0; CUSTOMGUI REALSLIDER; }
			REAL CYCLESSCATTER_NORMAL_THRESHOLD { UNIT DEGREE; MIN 0.0; MAX 180.0; STEP 1.0; CUSTOMGUI REALSLIDER; }
		}

		GROUP CYCLESSCATTER_GROUP_VARY
		{
			DEFAULT 1;

			// Each value goes from its Min where the shader is black to its Max where it is white.
			GROUP CYCLESSCATTER_GROUP_VARY_POSITION
			{
				DEFAULT 1;

				SHADERLINK CYCLESSCATTER_POSITION_SHADER { }
				GROUP
				{
					COLUMNS 2;
					REAL CYCLESSCATTER_POSITION_U_MIN { UNIT METER; STEP 1.0; }
					REAL CYCLESSCATTER_POSITION_U_MAX { UNIT METER; STEP 1.0; }
					REAL CYCLESSCATTER_POSITION_V_MIN { UNIT METER; STEP 1.0; }
					REAL CYCLESSCATTER_POSITION_V_MAX { UNIT METER; STEP 1.0; }
					REAL CYCLESSCATTER_POSITION_Y_MIN { UNIT METER; STEP 1.0; }
					REAL CYCLESSCATTER_POSITION_DISTANCE { UNIT METER; STEP 1.0; }
				}
			}
			GROUP CYCLESSCATTER_GROUP_VARY_ROTATION
			{
				DEFAULT 1;

				SHADERLINK CYCLESSCATTER_ROTATION_SHADER { }
				REAL CYCLESSCATTER_ROTATION_H_MIN { UNIT DEGREE; STEP 0.1; CUSTOMGUI REALSLIDER; MINSLIDER -180.0; MAXSLIDER 180.0; }
				REAL CYCLESSCATTER_ROTATION_H_MAX { UNIT DEGREE; STEP 0.1; CUSTOMGUI REALSLIDER; MINSLIDER -180.0; MAXSLIDER 180.0; }
				REAL CYCLESSCATTER_ROTATION_P_MIN { UNIT DEGREE; STEP 0.1; CUSTOMGUI REALSLIDER; MINSLIDER -180.0; MAXSLIDER 180.0; }
				REAL CYCLESSCATTER_ROTATION_ANGLE { UNIT DEGREE; STEP 0.1; CUSTOMGUI REALSLIDER; MINSLIDER -180.0; MAXSLIDER 180.0; }
				REAL CYCLESSCATTER_ROTATION_B_MIN { UNIT DEGREE; STEP 0.1; CUSTOMGUI REALSLIDER; MINSLIDER -180.0; MAXSLIDER 180.0; }
				REAL CYCLESSCATTER_ROTATION_B_MAX { UNIT DEGREE; STEP 0.1; CUSTOMGUI REALSLIDER; MINSLIDER -180.0; MAXSLIDER 180.0; }
			}
			GROUP CYCLESSCATTER_GROUP_VARY_SCALE
			{
				DEFAULT 1;

				SHADERLINK CYCLESSCATTER_SCALE_SHADER { }
				BOOL CYCLESSCATTER_SCALE_UNIFORM { }
				REAL CYCLESSCATTER_SCALE_MIN { UNIT PERCENT; MIN 0.0; STEP 1.0; CUSTOMGUI REALSLIDER; MINSLIDER 0.0; MAXSLIDER 200.0; }
				REAL CYCLESSCATTER_SCALE_MAX { UNIT PERCENT; MIN 0.0; STEP 1.0; CUSTOMGUI REALSLIDER; MINSLIDER 0.0; MAXSLIDER 200.0; }
				VECTOR CYCLESSCATTER_SCALE_MIN_AXES { UNIT PERCENT; MIN 0.0; STEP 1.0; }
				VECTOR CYCLESSCATTER_SCALE_MAX_AXES { UNIT PERCENT; MIN 0.0; STEP 1.0; }
			}
		}
	}

	// MoGraph's effectors, dragged in as into a Cloner's list; their fields act through them. A field list
	// of the object itself weights the density or the scale of the copies.
	GROUP CYCLESSCATTER_GROUP_EFFECTORS
	{
		DEFAULT 1;
		SCALE_V;

		GROUP CYCLESSCATTER_GROUP_EFFECTOR_LIST
		{
			DEFAULT 1;
			SCALE_V;

			IN_EXCLUDE CYCLESSCATTER_EFFECTORS
			{
				SCALE_V;
				NUM_FLAGS 1;
				INIT_STATE 1;
				IMAGE_01_ON 300000131;
				IMAGE_01_OFF 300000130;
				ACCEPT { Obaseeffector; }
			}
		}
		GROUP CYCLESSCATTER_GROUP_FIELD_LIST
		{
			DEFAULT 1;

			LONG CYCLESSCATTER_FIELDS_AFFECT
			{
				ANIM OFF;
				CYCLE
				{
					CYCLESSCATTER_FIELDS_AFFECT_DENSITY;
					CYCLESSCATTER_FIELDS_AFFECT_SCALE;
					CYCLESSCATTER_FIELDS_AFFECT_BOTH;
				}
			}
			FIELDLIST CYCLESSCATTER_FIELDS { ANIM ON; NEWLINE; NOCOLOR; NODIRECTION; NOROTATION; }
		}
	}

	// What the viewport draws: never the copies' geometry.
	GROUP CYCLESSCATTER_GROUP_DISPLAY
	{
		DEFAULT 1;

		LONG CYCLESSCATTER_DISPLAY
		{
			ANIM OFF;
			CYCLE
			{
				CYCLESSCATTER_DISPLAY_NONE;
				CYCLESSCATTER_DISPLAY_POINTS;
				CYCLESSCATTER_DISPLAY_BOXES;
			}
		}
		REAL CYCLESSCATTER_DISPLAY_RATE { UNIT PERCENT; MIN 0.0; MAX 100.0; STEP 1.0; CUSTOMGUI REALSLIDER; }
		LONG CYCLESSCATTER_DISPLAY_COLOR_MODE
		{
			ANIM OFF;
			CYCLE
			{
				CYCLESSCATTER_DISPLAY_COLOR_COPY;
				CYCLESSCATTER_DISPLAY_COLOR_CUSTOM;
			}
		}
		COLOR CYCLESSCATTER_DISPLAY_COLOR { }
	}
}
