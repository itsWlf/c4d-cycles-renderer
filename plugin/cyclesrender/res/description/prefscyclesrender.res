CONTAINER Prefscyclesrender
{
	NAME Prefscyclesrender;

	GROUP PREF_CYCLES_MAIN_GROUP
	{
		DEFAULT 1;
		COLUMNS 1;

		FILENAME PREF_CYCLES_BLENDER_PATH { ANIM OFF; }
		STATICTEXT PREF_CYCLES_BLENDER_STATUS { ANIM OFF; }
		BUTTON PREF_CYCLES_DETECT { }
	}

	// Blender's Preferences > System > Cycles Render Devices. The device list comes from a Blender
	// (the button); one checkbox per device of the chosen type is added by the page.
	GROUP PREF_CYCLES_DEVICE_GROUP
	{
		DEFAULT 1;
		COLUMNS 1;

		STATICTEXT PREF_CYCLES_DEVICE_NOTE { ANIM OFF; }
		LONG PREF_CYCLES_DEVICE_TYPE
		{
			ANIM OFF;
			CYCLE
			{
				PREF_CYCLES_DEVICE_TYPE_AUTOMATIC;
				PREF_CYCLES_DEVICE_TYPE_NONE;
				PREF_CYCLES_DEVICE_TYPE_OPTIX;
				PREF_CYCLES_DEVICE_TYPE_CUDA;
				PREF_CYCLES_DEVICE_TYPE_HIP;
				PREF_CYCLES_DEVICE_TYPE_ONEAPI;
				PREF_CYCLES_DEVICE_TYPE_METAL;
			}
		}
		BUTTON PREF_CYCLES_FIND_DEVICES { }
		STATICTEXT PREF_CYCLES_DEVICES_STATUS { ANIM OFF; }
	}

	// What of the IPR can be switched off when hunting a fault.
	GROUP PREF_CYCLES_IPR_GROUP
	{
		DEFAULT 1;
		COLUMNS 1;

		BOOL PREF_CYCLES_IPR_SKIP_UNCHANGED { ANIM OFF; }
	}
}
