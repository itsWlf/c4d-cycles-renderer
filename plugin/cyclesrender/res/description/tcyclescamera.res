CONTAINER Tcyclescamera
{
	NAME Tcyclescamera;
	INCLUDE Tbase;

	// Each tab begins with a switch; the settings below it are greyed out until it is on
	// (tags/camera_tag.cpp), and Focus Distance also while a focus object is set. Depth of Field
	// unchecked (the default, as Blender's) means no depth of field for this camera. Settings that do not belong to the chosen lens
	// or panorama type are hidden, as on Blender's panel.
	GROUP CYCLESCAMERA_GROUP_DOF
	{
		DEFAULT 1;

		BOOL CYCLESCAMERA_DOF_ENABLE { ANIM OFF; }
		SEPARATOR { LINE; }
		LINK CYCLESCAMERA_DOF_FOCUS_OBJECT { ACCEPT { Obase; } }
		REAL CYCLESCAMERA_DOF_FOCUS_DISTANCE { UNIT METER; MIN 0.0; STEP 1.0; }
		REAL CYCLESCAMERA_DOF_FSTOP { MIN 0.0; STEP 0.1; }

		GROUP CYCLESCAMERA_GROUP_APERTURE
		{
			DEFAULT 1;

			LONG CYCLESCAMERA_DOF_BLADES { MIN 0; MAX 16; }
			REAL CYCLESCAMERA_DOF_ROTATION { UNIT DEGREE; MIN -180.0; MAX 180.0; STEP 1.0; }
			REAL CYCLESCAMERA_DOF_RATIO { MIN 0.01; STEP 0.1; }
		}
	}

	// Only the first tab is open at first: with DEFAULT 1 on both, the Attribute Manager shows both
	// tabs at once and the panorama settings fall below its lower edge (screenshots, 0.2.0).
	GROUP CYCLESCAMERA_GROUP_LENS
	{
		LONG CYCLESCAMERA_LENS_TYPE
		{
			ANIM OFF;
			CYCLE
			{
				CYCLESCAMERA_LENS_TYPE_CAMERA;
				CYCLESCAMERA_LENS_TYPE_PERSPECTIVE;
				CYCLESCAMERA_LENS_TYPE_ORTHOGRAPHIC;
				CYCLESCAMERA_LENS_TYPE_PANORAMIC;
			}
		}
		SEPARATOR { LINE; }
		REAL CYCLESCAMERA_LENS_ORTHO_SCALE { UNIT METER; MIN 0.0; STEP 10.0; }

		GROUP CYCLESCAMERA_GROUP_PANORAMA
		{
			DEFAULT 1;

			LONG CYCLESCAMERA_LENS_PANORAMA_TYPE
			{
				ANIM OFF;
				CYCLE
				{
					CYCLESCAMERA_PANORAMA_EQUIRECTANGULAR;
					CYCLESCAMERA_PANORAMA_EQUIANGULAR_CUBEMAP_FACE;
					CYCLESCAMERA_PANORAMA_MIRRORBALL;
					CYCLESCAMERA_PANORAMA_FISHEYE_EQUIDISTANT;
					CYCLESCAMERA_PANORAMA_FISHEYE_EQUISOLID;
					CYCLESCAMERA_PANORAMA_FISHEYE_LENS_POLYNOMIAL;
					CYCLESCAMERA_PANORAMA_CENTRAL_CYLINDRICAL;
				}
			}
			REAL CYCLESCAMERA_LENS_FISHEYE_LENS { MIN 0.01; MAX 100.0; STEP 0.1; }
			REAL CYCLESCAMERA_LENS_FISHEYE_FOV { UNIT DEGREE; MIN 10.0; MAX 1800.0; STEP 1.0; }
			REAL CYCLESCAMERA_LENS_LATITUDE_MIN { UNIT DEGREE; MIN -90.0; MAX 90.0; STEP 1.0; }
			REAL CYCLESCAMERA_LENS_LATITUDE_MAX { UNIT DEGREE; MIN -90.0; MAX 90.0; STEP 1.0; }
			REAL CYCLESCAMERA_LENS_LONGITUDE_MIN { UNIT DEGREE; STEP 1.0; }
			REAL CYCLESCAMERA_LENS_LONGITUDE_MAX { UNIT DEGREE; STEP 1.0; }
			REAL CYCLESCAMERA_LENS_POLYNOMIAL_K0 { STEP 0.1; }
			REAL CYCLESCAMERA_LENS_POLYNOMIAL_K1 { STEP 0.1; }
			REAL CYCLESCAMERA_LENS_POLYNOMIAL_K2 { STEP 0.1; }
			REAL CYCLESCAMERA_LENS_POLYNOMIAL_K3 { STEP 0.1; }
			REAL CYCLESCAMERA_LENS_POLYNOMIAL_K4 { STEP 0.1; }
			REAL CYCLESCAMERA_LENS_CYLINDER_V_MIN { STEP 0.1; }
			REAL CYCLESCAMERA_LENS_CYLINDER_V_MAX { STEP 0.1; }
			REAL CYCLESCAMERA_LENS_CYLINDER_U_MIN { UNIT DEGREE; STEP 1.0; }
			REAL CYCLESCAMERA_LENS_CYLINDER_U_MAX { UNIT DEGREE; STEP 1.0; }
			REAL CYCLESCAMERA_LENS_CYLINDER_RADIUS { MIN 0.00001; STEP 0.1; }
		}
	}
}
