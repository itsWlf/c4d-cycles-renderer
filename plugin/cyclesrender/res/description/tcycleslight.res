CONTAINER Tcycleslight
{
	NAME Tcycleslight;
	INCLUDE Tbase;

	// Each tab begins with a switch; the settings below it are greyed out until it is on
	// (lights/light_tag.cpp). Light on: these replace what the light emits. The other tabs add
	// Blender's settings. What the chosen type or shape does not use is hidden, as on Blender's
	// panels. Only the first tab is open at first.
	GROUP CYCLESLIGHTTAG_GROUP_LIGHT
	{
		DEFAULT 1;

		BOOL CYCLESLIGHTTAG_LIGHT_ENABLE { ANIM OFF; }
		BUTTON CYCLESLIGHTTAG_TAKE_FROM_LIGHT { }
		SEPARATOR { LINE; }
		LONG CYCLESLIGHTTAG_TYPE
		{
			ANIM OFF;
			CYCLE
			{
				CYCLESLIGHTTAG_TYPE_POINT;
				CYCLESLIGHTTAG_TYPE_SUN;
				CYCLESLIGHTTAG_TYPE_SPOT;
				CYCLESLIGHTTAG_TYPE_AREA;
			}
		}
		SEPARATOR { LINE; }
		BOOL CYCLESLIGHTTAG_USE_TEMPERATURE { }
		REAL CYCLESLIGHTTAG_TEMPERATURE { MIN 800.0; MAX 20000.0; STEP 100.0; }
		COLOR CYCLESLIGHTTAG_COLOR { }
		SEPARATOR { LINE; }
		REAL CYCLESLIGHTTAG_ENERGY { STEP 1.0; }
		REAL CYCLESLIGHTTAG_EXPOSURE { MIN -32.0; MAX 32.0; STEP 0.1; }
		BOOL CYCLESLIGHTTAG_NORMALIZE { }
		SEPARATOR { LINE; }
		REAL CYCLESLIGHTTAG_RADIUS { UNIT METER; MIN 0.0; STEP 1.0; }
		BOOL CYCLESLIGHTTAG_SOFT_FALLOFF { }
		REAL CYCLESLIGHTTAG_ANGLE { UNIT DEGREE; MIN 0.0; MAX 180.0; STEP 0.1; }
		LONG CYCLESLIGHTTAG_SHAPE
		{
			ANIM OFF;
			CYCLE
			{
				CYCLESLIGHTTAG_SHAPE_SQUARE;
				CYCLESLIGHTTAG_SHAPE_RECTANGLE;
				CYCLESLIGHTTAG_SHAPE_DISK;
				CYCLESLIGHTTAG_SHAPE_ELLIPSE;
			}
		}
		REAL CYCLESLIGHTTAG_SIZE { UNIT METER; MIN 0.0; STEP 1.0; }
		REAL CYCLESLIGHTTAG_SIZE_Y { UNIT METER; MIN 0.0; STEP 1.0; }

		GROUP CYCLESLIGHTTAG_GROUP_BEAM
		{
			DEFAULT 1;

			REAL CYCLESLIGHTTAG_SPOT_SIZE { UNIT DEGREE; MIN 1.0; MAX 180.0; STEP 1.0; }
			REAL CYCLESLIGHTTAG_SPOT_BLEND { MIN 0.0; MAX 1.0; STEP 0.01; CUSTOMGUI REALSLIDER; }
			REAL CYCLESLIGHTTAG_SPREAD { UNIT DEGREE; MIN 0.0; MAX 180.0; STEP 1.0; }
		}
	}

	GROUP CYCLESLIGHTTAG_GROUP_SETTINGS
	{
		BOOL CYCLESLIGHTTAG_SETTINGS_ENABLE { ANIM OFF; }
		SEPARATOR { LINE; }
		LONG CYCLESLIGHTTAG_MAX_BOUNCES { MIN 0; MAX 1024; }
		BOOL CYCLESLIGHTTAG_CAST_SHADOW { }
		BOOL CYCLESLIGHTTAG_MULTIPLE_IMPORTANCE { }
		BOOL CYCLESLIGHTTAG_SHADOW_CAUSTICS { }
		BOOL CYCLESLIGHTTAG_PORTAL { }
	}

	GROUP CYCLESLIGHTTAG_GROUP_VISIBILITY
	{
		BOOL CYCLESLIGHTTAG_VISIBILITY_ENABLE { ANIM OFF; }
		SEPARATOR { LINE; }
		BOOL CYCLESLIGHTTAG_VISIBLE_CAMERA { }
		BOOL CYCLESLIGHTTAG_VISIBLE_DIFFUSE { }
		BOOL CYCLESLIGHTTAG_VISIBLE_GLOSSY { }
		BOOL CYCLESLIGHTTAG_VISIBLE_TRANSMISSION { }
		BOOL CYCLESLIGHTTAG_VISIBLE_VOLUME_SCATTER { }
	}

	GROUP CYCLESLIGHTTAG_GROUP_EEVEE
	{
		BOOL CYCLESLIGHTTAG_EEVEE_ENABLE { ANIM OFF; }
		SEPARATOR { LINE; }
		GROUP CYCLESLIGHTTAG_GROUP_EEVEE_SHADOW
		{
			DEFAULT 1;

			BOOL CYCLESLIGHTTAG_EEVEE_SHADOW_JITTER { }
			REAL CYCLESLIGHTTAG_EEVEE_SHADOW_OVERBLUR { UNIT PERCENT; MIN 0.0; MAX 100.0; STEP 1.0; }
			REAL CYCLESLIGHTTAG_EEVEE_SHADOW_FILTER { MIN 0.0; MAX 10.0; STEP 0.1; }
			REAL CYCLESLIGHTTAG_EEVEE_SHADOW_RESOLUTION { UNIT METER; MIN 0.0; STEP 0.01; }
			BOOL CYCLESLIGHTTAG_EEVEE_SHADOW_ABSOLUTE { }
		}
		GROUP CYCLESLIGHTTAG_GROUP_EEVEE_INFLUENCE
		{
			DEFAULT 1;

			REAL CYCLESLIGHTTAG_EEVEE_DIFFUSE_FACTOR { MIN 0.0; STEP 0.1; }
			REAL CYCLESLIGHTTAG_EEVEE_SPECULAR_FACTOR { MIN 0.0; STEP 0.1; }
			REAL CYCLESLIGHTTAG_EEVEE_TRANSMISSION_FACTOR { MIN 0.0; STEP 0.1; }
			REAL CYCLESLIGHTTAG_EEVEE_VOLUME_FACTOR { MIN 0.0; STEP 0.1; }
		}
		GROUP CYCLESLIGHTTAG_GROUP_EEVEE_DISTANCE
		{
			DEFAULT 1;

			BOOL CYCLESLIGHTTAG_EEVEE_USE_CUSTOM_DISTANCE { }
			REAL CYCLESLIGHTTAG_EEVEE_CUSTOM_DISTANCE { UNIT METER; MIN 0.0; STEP 10.0; }
		}
	}
}
