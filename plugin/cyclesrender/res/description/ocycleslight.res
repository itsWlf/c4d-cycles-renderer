CONTAINER Ocycleslight
{
	NAME Ocycleslight;
	INCLUDE Obase;

	// Blender's Light panel, its Settings panel (Cycles), the object's Ray Visibility and the
	// Eevee panels, with Blender's names and defaults. What the chosen type or shape does not use
	// is hidden, as on Blender's panels (lights/light_settings.cpp); the label of Power and Color
	// follows the type and the temperature as Blender's does. Only the first tab is open at first.
	GROUP CYCLESLIGHT_GROUP_LIGHT
	{
		DEFAULT 1;

		LONG CYCLESLIGHT_TYPE
		{
			ANIM OFF;
			CYCLE
			{
				CYCLESLIGHT_TYPE_POINT;
				CYCLESLIGHT_TYPE_SUN;
				CYCLESLIGHT_TYPE_SPOT;
				CYCLESLIGHT_TYPE_AREA;
			}
		}
		SEPARATOR { LINE; }
		BOOL CYCLESLIGHT_USE_TEMPERATURE { }
		REAL CYCLESLIGHT_TEMPERATURE { MIN 800.0; MAX 20000.0; STEP 100.0; }
		COLOR CYCLESLIGHT_COLOR { }
		SEPARATOR { LINE; }
		REAL CYCLESLIGHT_ENERGY { STEP 1.0; }
		REAL CYCLESLIGHT_EXPOSURE { MIN -32.0; MAX 32.0; STEP 0.1; }
		BOOL CYCLESLIGHT_NORMALIZE { }
		SEPARATOR { LINE; }
		REAL CYCLESLIGHT_RADIUS { UNIT METER; MIN 0.0; STEP 1.0; }
		BOOL CYCLESLIGHT_SOFT_FALLOFF { }
		REAL CYCLESLIGHT_ANGLE { UNIT DEGREE; MIN 0.0; MAX 180.0; STEP 0.1; }
		LONG CYCLESLIGHT_SHAPE
		{
			ANIM OFF;
			CYCLE
			{
				CYCLESLIGHT_SHAPE_SQUARE;
				CYCLESLIGHT_SHAPE_RECTANGLE;
				CYCLESLIGHT_SHAPE_DISK;
				CYCLESLIGHT_SHAPE_ELLIPSE;
			}
		}
		REAL CYCLESLIGHT_SIZE { UNIT METER; MIN 0.0; STEP 1.0; }
		REAL CYCLESLIGHT_SIZE_Y { UNIT METER; MIN 0.0; STEP 1.0; }

		GROUP CYCLESLIGHT_GROUP_BEAM
		{
			DEFAULT 1;

			REAL CYCLESLIGHT_SPOT_SIZE { UNIT DEGREE; MIN 1.0; MAX 180.0; STEP 1.0; }
			REAL CYCLESLIGHT_SPOT_BLEND { MIN 0.0; MAX 1.0; STEP 0.01; CUSTOMGUI REALSLIDER; }
			BOOL CYCLESLIGHT_SHOW_CONE { ANIM OFF; }
			REAL CYCLESLIGHT_SPREAD { UNIT DEGREE; MIN 0.0; MAX 180.0; STEP 1.0; }
		}
	}

	GROUP CYCLESLIGHT_GROUP_SETTINGS
	{
		LONG CYCLESLIGHT_MAX_BOUNCES { MIN 0; MAX 1024; }
		BOOL CYCLESLIGHT_CAST_SHADOW { }
		BOOL CYCLESLIGHT_MULTIPLE_IMPORTANCE { }
		BOOL CYCLESLIGHT_SHADOW_CAUSTICS { }
		BOOL CYCLESLIGHT_PORTAL { }
	}

	GROUP CYCLESLIGHT_GROUP_VISIBILITY
	{
		BOOL CYCLESLIGHT_VISIBLE_CAMERA { }
		BOOL CYCLESLIGHT_VISIBLE_DIFFUSE { }
		BOOL CYCLESLIGHT_VISIBLE_GLOSSY { }
		BOOL CYCLESLIGHT_VISIBLE_TRANSMISSION { }
		BOOL CYCLESLIGHT_VISIBLE_VOLUME_SCATTER { }
	}

	GROUP CYCLESLIGHT_GROUP_EEVEE
	{
		GROUP CYCLESLIGHT_GROUP_EEVEE_SHADOW
		{
			DEFAULT 1;

			BOOL CYCLESLIGHT_EEVEE_SHADOW_JITTER { }
			REAL CYCLESLIGHT_EEVEE_SHADOW_OVERBLUR { UNIT PERCENT; MIN 0.0; MAX 100.0; STEP 1.0; }
			REAL CYCLESLIGHT_EEVEE_SHADOW_FILTER { MIN 0.0; MAX 10.0; STEP 0.1; }
			REAL CYCLESLIGHT_EEVEE_SHADOW_RESOLUTION { UNIT METER; MIN 0.0; STEP 0.01; }
			BOOL CYCLESLIGHT_EEVEE_SHADOW_ABSOLUTE { }
		}
		GROUP CYCLESLIGHT_GROUP_EEVEE_INFLUENCE
		{
			DEFAULT 1;

			REAL CYCLESLIGHT_EEVEE_DIFFUSE_FACTOR { MIN 0.0; STEP 0.1; }
			REAL CYCLESLIGHT_EEVEE_SPECULAR_FACTOR { MIN 0.0; STEP 0.1; }
			REAL CYCLESLIGHT_EEVEE_TRANSMISSION_FACTOR { MIN 0.0; STEP 0.1; }
			REAL CYCLESLIGHT_EEVEE_VOLUME_FACTOR { MIN 0.0; STEP 0.1; }
		}
		GROUP CYCLESLIGHT_GROUP_EEVEE_DISTANCE
		{
			DEFAULT 1;

			BOOL CYCLESLIGHT_EEVEE_USE_CUSTOM_DISTANCE { }
			REAL CYCLESLIGHT_EEVEE_CUSTOM_DISTANCE { UNIT METER; MIN 0.0; STEP 10.0; }
		}
	}

	// As the Project tab of Cinema 4D's own lights: the light lights only these, or all but these,
	// and their shadows follow.
	GROUP CYCLESLIGHT_GROUP_LINKING
	{
		SCALE_V;

		LONG CYCLESLIGHT_LINKING_MODE
		{
			ANIM OFF;
			CYCLE
			{
				CYCLESLIGHT_LINKING_MODE_EXCLUDE;
				CYCLESLIGHT_LINKING_MODE_INCLUDE;
			}
		}
		IN_EXCLUDE CYCLESLIGHT_LINKING_LIST
		{
			SCALE_V;
			SMALL_MODE_SIZE 80;
			BIG_MODE_SIZE 160;
			NUM_FLAGS 0;
			INIT_STATE 0;
			ACCEPT { Obase; };
		}
	}
}
