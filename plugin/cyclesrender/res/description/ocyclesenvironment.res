// SPDX-License-Identifier: Apache-2.0
CONTAINER Ocyclesenvironment
{
	NAME Ocyclesenvironment;
	INCLUDE Obase;

	// The type, then one group per type; only the chosen type's group shows. The names and options of
	// the Sky Texture's and the HDRI's settings are Blender's, filled in from the node table
	// (objects/environment_object.cpp, GetDDescription); the ranges are Blender's own (Blender 5.2.3,
	// rna_nodetree.cc, def_sh_tex_sky).
	GROUP CYCLESENV_GROUP_ENVIRONMENT
	{
		DEFAULT 1;

		LONG CYCLESENV_TYPE
		{
			ANIM OFF;
			CYCLE
			{
				CYCLESENV_TYPE_COLOR;
				CYCLESENV_TYPE_SKY;
				CYCLESENV_TYPE_HDRI;
				CYCLESENV_TYPE_MATERIAL;
			}
		}
		REAL CYCLESENV_STRENGTH { MIN 0.0; STEP 0.1; }
		BOOL CYCLESENV_SEEN_BY_CAMERA { }
		BOOL CYCLESENV_LIGHTS_SCENE { }
		SEPARATOR { LINE; }
		COLOR CYCLESENV_COLOR { }

		GROUP CYCLESENV_GROUP_SKY
		{
			DEFAULT 1;

			LONG CYCLESENV_SKY_TYPE { ANIM OFF; CYCLE { } }
			BOOL CYCLESENV_SKY_SUN_DISC { }
			REAL CYCLESENV_SKY_SUN_SIZE { UNIT DEGREE; MIN 0.0; MAX 90.0; STEP 0.1; CUSTOMGUI REALSLIDER; MINSLIDER 0.0; MAXSLIDER 90.0; }
			REAL CYCLESENV_SKY_SUN_INTENSITY { MIN 0.0; MAX 1000.0; STEP 0.1; }
			REAL CYCLESENV_SKY_SUN_ELEVATION { UNIT DEGREE; STEP 0.1; CUSTOMGUI REALSLIDER; MINSLIDER -90.0; MAXSLIDER 90.0; }
			REAL CYCLESENV_SKY_SUN_ROTATION { UNIT DEGREE; STEP 0.1; CUSTOMGUI REALSLIDER; MINSLIDER 0.0; MAXSLIDER 360.0; }
			REAL CYCLESENV_SKY_ALTITUDE { MIN 0.0; MAX 100000.0; STEP 0.1; }
			REAL CYCLESENV_SKY_AIR_DENSITY { MIN 0.0; MAX 1000.0; STEP 0.01; CUSTOMGUI REALSLIDER; MINSLIDER 0.0; MAXSLIDER 10.0; }
			REAL CYCLESENV_SKY_AEROSOL_DENSITY { MIN 0.0; MAX 1000.0; STEP 0.01; CUSTOMGUI REALSLIDER; MINSLIDER 0.0; MAXSLIDER 10.0; }
			REAL CYCLESENV_SKY_OZONE_DENSITY { MIN 0.0; MAX 1000.0; STEP 0.01; CUSTOMGUI REALSLIDER; MINSLIDER 0.0; MAXSLIDER 10.0; }
			REAL CYCLESENV_SKY_TURBIDITY { MIN 1.0; MAX 10.0; STEP 0.01; CUSTOMGUI REALSLIDER; }
			REAL CYCLESENV_SKY_GROUND_ALBEDO { MIN 0.0; MAX 1.0; STEP 0.01; CUSTOMGUI REALSLIDER; }
			LINK CYCLESENV_SKY_SUN_LIGHT { ACCEPT { Olight; 1036751; 1073987; } }
		}

		GROUP CYCLESENV_GROUP_HDRI
		{
			DEFAULT 1;

			FILENAME CYCLESENV_HDRI_FILE { }
			LONG CYCLESENV_HDRI_COLORSPACE { ANIM OFF; CYCLE { } }
			LONG CYCLESENV_HDRI_PROJECTION { ANIM OFF; CYCLE { } }
			LONG CYCLESENV_HDRI_INTERPOLATION { ANIM OFF; CYCLE { } }
			GROUP
			{
				COLUMNS 2;

				BUTTON CYCLESENV_HDRI_MAKE_RELATIVE { }
				BUTTON CYCLESENV_HDRI_MAKE_ABSOLUTE { }
			}
		}
	}

	// A fog that fills the whole world, with the Cycles Fog's wording (ocyclesfog.res). Of several
	// environments with it on, the highest in the Object Manager counts.
	GROUP CYCLESENV_GROUP_FOG
	{
		BOOL CYCLESENV_FOG_ENABLE { ANIM OFF; }
		SEPARATOR { LINE; }
		COLOR CYCLESENV_FOG_COLOR { }
		REAL CYCLESENV_FOG_DENSITY { MIN 0.0; STEP 0.001; }
		REAL CYCLESENV_FOG_ANISOTROPY { MIN -1.0; MAX 1.0; STEP 0.05; CUSTOMGUI REALSLIDER; }
		COLOR CYCLESENV_FOG_ABSORPTION_COLOR { }
		SEPARATOR { LINE; }
		REAL CYCLESENV_FOG_EMISSION_STRENGTH { MIN 0.0; STEP 0.1; }
		COLOR CYCLESENV_FOG_EMISSION_COLOR { }
	}
}
