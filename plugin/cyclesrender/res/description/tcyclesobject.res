CONTAINER Tcyclesobject
{
	NAME Tcyclesobject;
	INCLUDE Tbase;

	GROUP CYCLESOBJECT_GROUP_VISIBILITY
	{
		DEFAULT 1;

		BOOL CYCLESOBJECT_VISIBILITY_ENABLE { ANIM OFF; }
		SEPARATOR { LINE; }
		GROUP
		{
			COLUMNS 2;

			BOOL CYCLESOBJECT_VISIBILITY_CAMERA { }
			BOOL CYCLESOBJECT_VISIBILITY_SHADOW { }
			BOOL CYCLESOBJECT_VISIBILITY_DIFFUSE { }
			BOOL CYCLESOBJECT_VISIBILITY_GLOSSY { }
			BOOL CYCLESOBJECT_VISIBILITY_TRANSMISSION { }
			BOOL CYCLESOBJECT_VISIBILITY_VOLUME_SCATTER { }
		}
		SEPARATOR { LINE; }
		GROUP
		{
			COLUMNS 2;

			BOOL CYCLESOBJECT_VISIBILITY_HOLDOUT { }
			BOOL CYCLESOBJECT_VISIBILITY_SHADOW_CATCHER { }
		}
	}

	// A list objects are dragged into is the last thing on its tab and may grow downwards
	// (SCALE_V on the tab and on the list). SMALL_MODE_SIZE and BIG_MODE_SIZE are the list's height
	// in pixels, empty and filled; the bar below it resizes it.
	GROUP CYCLESOBJECT_GROUP_LINKING
	{
		DEFAULT 1;
		SCALE_V;

		BOOL CYCLESOBJECT_LINKING_ENABLE { ANIM OFF; }
		SEPARATOR { LINE; }
		LONG CYCLESOBJECT_LINKING_MODE
		{
			ANIM OFF;
			CYCLE
			{
				CYCLESOBJECT_LINKING_MODE_EXCLUDE;
				CYCLESOBJECT_LINKING_MODE_INCLUDE;
			}
		}
		IN_EXCLUDE CYCLESOBJECT_LINKING_LIGHTS
		{
			SCALE_V;
			SMALL_MODE_SIZE 80;
			BIG_MODE_SIZE 160;
			NUM_FLAGS 0;
			INIT_STATE 0;
			ACCEPT { Olight; 1036751; 1073987; };
		}
	}

	GROUP CYCLESOBJECT_GROUP_INSTANCES
	{
		DEFAULT 1;
		SCALE_V;

		BOOL CYCLESOBJECT_INSTANCES_ENABLE { ANIM OFF; }
		SEPARATOR { LINE; }
		REAL CYCLESOBJECT_INSTANCES_SCALE { UNIT PERCENT; MIN 0.0; STEP 1.0; }
		BOOL CYCLESOBJECT_INSTANCES_USE_RADIUS { }
		IN_EXCLUDE CYCLESOBJECT_INSTANCES_OBJECTS
		{
			SCALE_V;
			SMALL_MODE_SIZE 80;
			BIG_MODE_SIZE 160;
			NUM_FLAGS 0;
			INIT_STATE 0;
			ACCEPT { Obase; };
		}
	}

	GROUP CYCLESOBJECT_GROUP_VOLUME
	{
		DEFAULT 1;

		BOOL CYCLESOBJECT_VOLUME_ENABLE { ANIM OFF; }
		SEPARATOR { LINE; }
		REAL CYCLESOBJECT_VOLUME_DENSITY { MIN 0.0; STEP 0.1; }
		COLOR CYCLESOBJECT_VOLUME_COLOR { }
		REAL CYCLESOBJECT_VOLUME_ANISOTROPY { MIN -1.0; MAX 1.0; STEP 0.05; }
		SEPARATOR { LINE; }
		REAL CYCLESOBJECT_VOLUME_EMISSION_STRENGTH { MIN 0.0; STEP 0.1; }
		COLOR CYCLESOBJECT_VOLUME_EMISSION_COLOR { }
		LONG CYCLESOBJECT_VOLUME_FIRE_MODE
		{
			ANIM OFF;
			CYCLE
			{
				CYCLESOBJECT_VOLUME_FIRE_MODE_AUTO;
				CYCLESOBJECT_VOLUME_FIRE_MODE_TEMPERATURE;
				CYCLESOBJECT_VOLUME_FIRE_MODE_BRIGHTNESS;
			}
		}
		REAL CYCLESOBJECT_VOLUME_BLACKBODY { MIN 0.0; STEP 0.1; }
		REAL CYCLESOBJECT_VOLUME_TEMPERATURE { MIN 0.0; STEP 100.0; }
		SEPARATOR { LINE; }
		STRING CYCLESOBJECT_VOLUME_DENSITY_GRID { }
		STRING CYCLESOBJECT_VOLUME_TEMPERATURE_GRID { }
		STRING CYCLESOBJECT_VOLUME_COLOR_GRID { }
	}
}
